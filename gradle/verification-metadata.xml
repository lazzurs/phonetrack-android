   <!--
      Checksums for what comes from JitPack (settings.gradle.kts): JitPack builds its artifacts from
      Git on demand and can rebuild them, so the bytes behind a version are not fixed the way they
      are on Maven Central or Google's repository. Gradle refuses an artifact of these two groups
      whose SHA-256 is not the one recorded here. Every other group is trusted as downloaded.
      After changing the version of cert4android or Android-SingleSignOn, review the new code, then
      replace its checksums (RELEASING.md, "Dependencies").
   -->
   <configuration>
      <verify-metadata>true</verify-metadata>
      <verify-signatures>false</verify-signatures>
      <trusted-artifacts>
         <trust group="^(?!com[.]github[.](bitfireat|nextcloud)$).*$" regex="true"/>
      </trusted-artifacts>
   </configuration>
