<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/mapActivityActionBar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/bg_normal"
        app:elevation="4dp" />

    <RelativeLayout
        xmlns:tools="http://schemas.android.com/tools"
        android:id="@+id/relativelayoutMap"
        android:orientation="vertical"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        tools:ignore="MergeRootFrame">

    <org.osmdroid.views.MapView
        android:id="@+id/map"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent" />

        <!-- the map buttons: 48dp touch targets, scrolling if the screen is too short
             (landscape on a small phone) instead of being cut off -->
        <ScrollView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_alignParentEnd="true">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#33000000"
                android:orientation="vertical"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp">

                <ImageButton
                    android:id="@+id/ic_map_layers"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="48dp"
                    android:minHeight="48dp"
                    android:padding="12dp"
                    android:src="@drawable/ic_map_grey_24dp"
                    android:background="#00ffffff"
                    android:contentDescription="@string/map_choose_layer"
                    android:tooltipText="@string/map_choose_layer"
                    android:cropToPadding="true" />

                <ImageButton
                    android:id="@+id/ic_center_map"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:minWidth="48dp"
                    android:minHeight="48dp"
                    android:padding="12dp"
                    android:src="@drawable/ic_crosshairs_gps_grey_24dp"
                    android:background="#00ffffff"
                    android:contentDescription="@string/center_map"
                    android:tooltipText="@string/center_map"
                    android:cropToPadding="true" />

                <ImageButton
                    android:id="@+id/ic_follow_me"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:minWidth="48dp"
                    android:minHeight="48dp"
                    android:padding="12dp"
                    android:src="@drawable/ic_directions_grey_24dp"
                    android:background="#00ffffff"
                    android:contentDescription="@string/follow_me"
                    android:tooltipText="@string/follow_me"
                    android:cropToPadding="true" />

                <ImageButton
                    android:id="@+id/ic_zoom_all"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:minWidth="48dp"
                    android:minHeight="48dp"
                    android:padding="12dp"
                    android:src="@drawable/ic_magnify_grey_24dp"
                    android:background="#00ffffff"
                    android:contentDescription="@string/zoom_all_markers"
                    android:tooltipText="@string/zoom_all_markers"
                    android:cropToPadding="true" />

                <ImageButton
                    android:id="@+id/ic_zoom_auto"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:minWidth="48dp"
                    android:minHeight="48dp"
                    android:padding="12dp"
                    android:src="@drawable/ic_magnify_plus_outline_grey_24dp"
                    android:background="#00ffffff"
                    android:contentDescription="@string/auto_zoom"
                    android:tooltipText="@string/auto_zoom"
                    android:cropToPadding="true" />

                <ImageButton
                    android:id="@+id/ic_allow_rotation"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:minWidth="48dp"
                    android:minHeight="48dp"
                    android:padding="12dp"
                    android:src="@drawable/ic_rotate_left_black_24dp"
                    android:background="#00ffffff"
                    android:contentDescription="@string/allow_rotation"
                    android:tooltipText="@string/allow_rotation"
                    android:cropToPadding="true" />
            </LinearLayout>
        </ScrollView>
    </RelativeLayout>

    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
