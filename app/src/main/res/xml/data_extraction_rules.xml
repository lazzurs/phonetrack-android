<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+.
     Cloud backup: the database (session tokens, log job URLs and logins, recorded
     positions, system log) is never uploaded, nor are the passwords
     (CredentialStore.FILE_NAME) or the Nextcloud Single Sign-On token file
     ("single-sign-on", Constants.SSO_SHARED_PREFERENCE in Android-SingleSignOn).
     Only the ordinary preferences remain. The backup is only made when it can be
     encrypted client-side.
     Device transfer (direct, started by the owner): keeps the database so log jobs
     survive a phone-to-phone migration. Passwords and the SSO token are left out so
     that secrets never leave the device: the owner signs in again on the new phone. -->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="credentials.xml" />
        <exclude domain="sharedpref" path="single-sign-on.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="credentials.xml" />
        <exclude domain="sharedpref" path="single-sign-on.xml" />
    </device-transfer>
</data-extraction-rules>
